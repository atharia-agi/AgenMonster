root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4
max_width = 100

[*.{svelte,ts,js}]
indent_style = space
indent_size = 2
