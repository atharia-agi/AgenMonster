    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "200ms",
      "slow": "300ms",
      "cinematic": "500ms",
      "epic": "1000ms"
    },
    "easing": {
      "linear": "linear",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "springSoft": "cubic-bezier(0.5, 1.8, 0.5, 1)",
      "anticipate": "cubic-bezier(0.6, -0.4, 0.4, 1.4)"
    },
    "stagger": {
      "base": 30,
      "tight": 15,
      "loose": 60
    },
    "keyframes": {
      "fadeIn": { "0%": { "opacity": 0 }, "100%": { "opacity": 1 } },
      "fadeOut": { "0%": { "opacity": 1 }, "100%": { "opacity": 0 } },
      "slideUp": { "0%": { "transform": "translateY(100%)" }, "100%": { "transform": "translateY(0)" } },
      "slideDown": { "0%": { "transform": "translateY(-100%)" }, "100%": { "transform": "translateY(0)" } },
      "scaleIn": { "0%": { "transform": "scale(0.9)" }, "100%": { "transform": "scale(1)" } },
      "pulse": { "0%, 100%": { "transform": "scale(1)" }, "50%": { "transform": "scale(1.05)" } },
      "breathe": { "0%, 100%": { "transform": "scale(1)" }, "50%": { "transform": "scale(1.02)" } },
      "shake": { "0%, 100%": { "transform": "translateX(0)" }, "25%": { "transform": "translateX(-4px)" }, "75%": { "transform": "translateX(4px)" } },
      "wobble": { "0%, 100%": { "transform": "rotate(0deg)" }, "25%": { "transform": "rotate(-3deg)" }, "75%": { "transform": "rotate(3deg)" } },
      "orbit": { "0%": { "transform": "rotate(0deg) translateX(20px) rotate(0deg)" }, "100%": { "transform": "rotate(360deg) translateX(20px) rotate(-360deg)" } }
    }
  },
  "breakpoints": {
    "xs": "320px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "3xl": "1920px"
