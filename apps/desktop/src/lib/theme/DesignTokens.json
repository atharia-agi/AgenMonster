    "modalBackdrop": 400,
    "modal": 500,
    "popover": 600,
    "tooltip": 700,
    "toast": 800,
    "maximum": 9999
  },
  "quality": {
    "low": { "particles": 20, "shadows": false, "blur": false, "postProcess": false, "targetFps": 30 },
    "medium": { "particles": 60, "shadows": true, "blur": true, "postProcess": false, "targetFps": 60 },
    "high": { "particles": 150, "shadows": true, "blur": true, "postProcess": true, "targetFps": 60 },
    "ultra": { "particles": 300, "shadows": true, "blur": true, "postProcess": true, "rayTraced": true, "targetFps": 120 }
  },
  "colorBlind": {
    "protanopia": { "hueShift": -15, "saturation": 0.85, "description": "Red-blind" },
    "deuteranopia": { "hueShift": 15, "saturation": 0.85, "description": "Green-blind" },
    "tritanopia": { "hueShift": 90, "saturation": 0.8, "description": "Blue-blind" },
    "achromatopsia": { "saturation": 0, "contrast": 1.3, "description": "Monochrome" },
    "protanomaly": { "hueShift": -8, "saturation": 0.92, "description": "Red-weak" },
    "deuteranomaly": { "hueShift": 8, "saturation": 0.92, "description": "Green-weak" },
    "tritanomaly": { "hueShift": 45, "saturation": 0.9, "description": "Blue-weak" },
    "coneMonochromacy": { "saturation": 0.1, "contrast": 1.2, "description": "Single cone" }
  }
