{
  "productName": "AgenMonster Desktop",
  "version": "1.0.0",
  "identifier": "dev.agenmonster.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "AgenMonster",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "url": "/"
      },
      {
        "label": "chat",
        "title": "AgenMonster Chat",
        "width": 400,
        "height": 500,
        "resizable": true,
        "visible": false,
        "url": "/?window=chat"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' https: http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "targets": ["app"],
    "publisher": "AgenMonster Team",
    "copyright": "Copyright (c) 2025 AgenMonster Team",
    "shortDescription": "Your evolving AI monster companion",
    "longDescription": "A floating AI pet companion that lives on your desktop. Built with Tauri 2 + SvelteKit. Open source under MIT/Apache-2.0.",
    "category": "SocialNetworking",
    "externalBin": [],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": null
    }
  },
  "plugins": {
    "globalShortcut": {
      "shortcuts": [
        "CmdOrCtrl+Shift+A"
      ]
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "AgenMonster"
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/atharia-agi/AgenMonster/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxODM5NDQxNUMzNUIwQ0QKUldRUnZoZnJiViZ3bHJFUmNFNnBjSDBvcmRLSDVQWFJWcGthQTh1OXNFdTlIRWd6Um96VnZBMkUK"
    },
    "window-state": {
      "allWindows": true
    }
  }
}
